{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Payment readiness result",
  "type": "object",
  "additionalProperties": false,
  "required": ["payment_request_line_id", "milestone_id", "rule_version", "evaluated_at", "decision", "checks"],
  "properties": {
    "payment_request_line_id": { "type": "string", "minLength": 1 },
    "milestone_id": { "type": "string", "minLength": 1 },
    "rule_version": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "decision": { "enum": ["eligible_for_review", "pending_documents", "manual_verification", "blocked"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "source_refs"],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["satisfied", "failed", "missing", "unavailable", "conflicting", "not_applicable"]
          },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "next_role": { "type": "string", "minLength": 1 }
  },
  "if": { "properties": { "decision": { "const": "eligible_for_review" } } },
  "then": {
    "properties": {
      "checks": {
        "items": { "properties": { "status": { "enum": ["satisfied", "not_applicable"] } } },
        "contains": { "properties": { "status": { "const": "satisfied" } } }
      }
    }
  }
}
